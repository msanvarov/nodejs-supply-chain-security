{
  "name": "nodejs-supply-chain-security",
  "version": "1.0.0",
  "private": true,
  "description": "npm supply-chain defenses: safe npm config, CI audit, install-script scanner, and the Node permission model",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "demo": "node demo/server.js",
    "scan": "node scripts/find-install-scripts.js",
    "demo:open": "node permission-demo/app.mjs",
    "demo:locked": "node --permission --allow-fs-read=./permission-demo permission-demo/app.mjs",
    "demo:record": "node demo/static.mjs record",
    "build": "node demo/static.mjs build"
  }
}
